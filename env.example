# ============================================
# JuraMind Backend - Environment Variables
# Kopieren zu .env und Werte anpassen!
# ============================================

# App Settings
APP_NAME="JuraMind API"
APP_VERSION="1.0.0"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
# Lokal:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/juramind
# Railway (aus Railway Dashboard kopieren):
# DATABASE_URL=postgresql+asyncpg://postgres:xxx@xxx.railway.app:5432/railway

# JWT Security
# WICHTIG: In Produktion einen sicheren Key generieren!
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Frontend URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://juramind.vercel.app"]

# KI Provider: "openai" oder "anthropic"
AI_PROVIDER=anthropic

# OpenAI (falls AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude (falls AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_UPLOAD_SIZE_MB=10

